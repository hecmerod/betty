{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Server Development ",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "betty-server:dev"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "🧪 Server Test ",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "betty-server:test"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "test"
      }
    },
    {
      "name": "🔨 Server Build ",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "betty-server:build"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production"
      }
    },
    {
      "name": "🚀 App Release ",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/betty_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/betty_app",
      "internalConsoleOptions": "openOnSessionStart",
      "flutterMode": "release",
    },
    {
      "name": "🐛 App Debug ",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/betty_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/betty_app",
      "internalConsoleOptions": "openOnSessionStart",
      "flutterMode": "debug",
    },
  ]
}