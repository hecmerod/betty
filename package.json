{
  "name": "@betty-workspace/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "install:all": "npm install && nx run betty:install",
    "build": "nx build betty",
    "serve": "nx serve betty",
    "start": "node dist/apps/betty/main.js",
    "start:dev": "nx serve betty",
    "start:debug": "nx serve betty --inspect",
    "start:prod": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=512' node dist/apps/betty/main.js",
    "start:rpi": "./scripts/start-rpi.sh",
    "start:secure": "./scripts/start-prod-secure.sh",
    "test": "nx test betty",
    "test:e2e": "nx e2e betty-e2e",
    "lint": "nx lint betty",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop betty-server",
    "pm2:restart": "pm2 restart betty-server",
    "pm2:status": "pm2 status",
    "docker:build:rpi": "docker build -f Dockerfile.rpi -t betty-server:rpi .",
    "docker:run:rpi": "docker run -p 3000:3000 --name betty-container betty-server:rpi"
  },
  "private": true,
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nx/eslint": "21.6.3",
    "@nx/eslint-plugin": "21.6.3",
    "@nx/jest": "21.6.3",
    "@nx/js": "21.6.3",
    "@nx/nest": "21.6.3",
    "@nx/node": "21.6.3",
    "@nx/web": "21.6.3",
    "@nx/webpack": "21.6.3",
    "@nx/workspace": "21.6.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "nx": "21.6.3",
    "prettier": "^2.6.2",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  }
