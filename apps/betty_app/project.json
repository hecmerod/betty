{
  "name": "betty-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/betty_app",
  "tags": ["type:app", "platform:flutter"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter run",
        "cwd": "apps/betty_app"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter build apk --release",
        "cwd": "apps/betty_app"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter build ios --release",
        "cwd": "apps/betty_app"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter test",
        "cwd": "apps/betty_app"
      }
    },
    "analyze": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter analyze",
        "cwd": "apps/betty_app"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dart format .",
        "cwd": "apps/betty_app"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter clean",
        "cwd": "apps/betty_app"
      }
    },
    "deps-get": {
      "executor": "nx:run-commands",
      "options": {
        "command": "flutter pub get",
        "cwd": "apps/betty_app"
      }
    }
  }
}