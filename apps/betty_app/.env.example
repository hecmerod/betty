# Betty Server Configuration
# Configuración del servidor Betty para la aplicación Flutter

# Host/IP del servidor Betty (sin protocolo)
BETTY_SERVER_HOST=192.168.1.232

# Puerto del servidor Betty
BETTY_SERVER_PORT=3000

# URL completa de la API (incluye protocolo, host, puerto y path)
BETTY_API_BASE_URL=http://192.168.1.232:3000/api