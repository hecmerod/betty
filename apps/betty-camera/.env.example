# Betty Camera - Configuración del servidor (Ejemplo)
# Copia este archivo como .env y ajusta los valores según sea necesario

# Host del servidor (0.0.0.0 para escuchar en todas las interfaces)
HOST=0.0.0.0

# Puerto del servidor
PORT=8001

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

DEV_MODE=true