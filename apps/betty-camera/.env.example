# Betty Camera - Configuración del servidor (Ejemplo)
# Copia este archivo como .env y ajusta los valores según sea necesario

# Host del servidor (0.0.0.0 para escuchar en todas las interfaces)
HOST=0.0.0.0

# Puerto del servidor
PORT=8001

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

DEV_MODE=true

# === CONFIGURACIÓN BETTY-SERVER ===
# URL base de betty-server para comunicación HTTP
BETTY_SERVER_URL=http://localhost:3000/api

# Secreto JWT (debe coincidir con betty-server/.env)
JWT_SECRET=betty-secret-key-2024-fallback

# Tiempo de expiración del JWT
JWT_EXPIRES_IN=24h