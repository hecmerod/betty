{
  "name": "betty-server",
  "version": "1.0.0",
  "description": "NestJS server optimized for Raspberry Pi ARM architecture",
  "main": "src/main.ts",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/src/main.js",
    "test": "NODE_ENV=test NODE_OPTIONS='--no-deprecation' jest",
    "test:watch": "NODE_ENV=test NODE_OPTIONS='--no-deprecation' jest --watch",
    "test:coverage": "NODE_ENV=test NODE_OPTIONS='--no-deprecation' jest --coverage",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:reset": "npx prisma migrate reset",
    "prisma:studio": "npx prisma studio"
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "@liminal-machines-co/gpio": "^0.0.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.17.1",
    "@types/noble": "^0.0.44",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.3.1",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "onnxruntime-node": "^1.23.2",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "20.19.9",
    "nodemon": "^3.0.2",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0"
  },
  "peerDependencies": {
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "nestjs",
    "raspberry-pi",
    "arm",
    "server",
    "iot"
  ],
  "author": "hecmerod",
  "license": "MIT"
}
