// Prisma schema para betty-server
// Fuente de datos PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generador del cliente
generator client {
  provider = "prisma-client-js"
}

// Modelo Alarm - solo puede haber un registro (singleton)
model Alarm {
  id                Int       @id @default(1) // Forzamos siempre id = 1
  isActive          Boolean   @default(false)
  password          String    @default("1234")
  createdAt         DateTime  @default(now())
  lastActivatedAt   DateTime?
  lastDeactivatedAt DateTime?
  lastTriggeredAt   DateTime?

  @@map("alarms")
}

// Modelo Sensor - configuración de sensores (puertas, movimiento y ubicación)
model Sensor {
  id          String   @id // 'motion', 'door_claraboyas', 'door_trasera', 'door_lateral', 'door_delanteras', 'location'
  isListening Boolean  @default(true) // Si está escuchando eventos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sensors")
}

// Modelo DeviceToken - tokens de dispositivos para notificaciones push
model DeviceToken {
  token        String   @id // El token es único, lo usamos como PK
  registeredAt DateTime @default(now())
  lastUsed     DateTime @default(now())
  userId       String?  // Opcional - para asociar con usuario
  platform     String?  // Opcional - iOS, Android, etc.

  @@map("device_tokens")
}

// Modelo Location - ubicaciones GPS
model Location {
  id         String   @id // UUID
  latitude   Float
  longitude  Float
  altitude   Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@map("locations")
  @@index([recordedAt])
}