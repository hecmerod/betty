// Prisma schema para betty-server
// Fuente de datos PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Generador del cliente
generator client {
  provider = "prisma-client-js"
}

// Modelo Alarm - solo puede haber un registro (singleton)
model Alarm {
  id                  Int       @id @default(1) // Forzamos siempre id = 1
  isActive            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  lastActivatedAt     DateTime?
  lastDeactivatedAt   DateTime?
  lastTriggeredAt     DateTime?

  @@map("alarms")
}

// Modelo DeviceToken - tokens de dispositivos para notificaciones push
model DeviceToken {
  token        String   @id // El token es único, lo usamos como PK
  registeredAt DateTime @default(now())
  lastUsed     DateTime @default(now())
  userId       String?  // Opcional - para asociar con usuario
  platform     String?  // Opcional - iOS, Android, etc.

  @@map("device_tokens")
}

// Modelo Trip - viajes
model Trip {
  id        String    @id // UUID
  name      String    // Nombre del viaje
  startedAt DateTime  // Fecha y hora de inicio
  endedAt   DateTime? // Fecha y hora de finalización (null si está en progreso)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("trips")
  @@index([startedAt])
  @@index([endedAt])
}
