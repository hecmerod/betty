{
  "name": "betty-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/betty-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/node_modules"],
      "options": {
        "command": "npm install",
        "cwd": "apps/betty-server"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["install"],
      "outputs": ["{workspaceRoot}/betty-server/dist/"],
      "options": {
        "main": "apps/betty-server/src/main.ts",
        "tsConfig": "apps/betty-server/tsconfig.app.json",
        "outputPath": "apps/betty-server/dist",
        "clean": true
      },
      "configurations": {
        "production": {
          "dependsOn": ["install"],
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "cwd": "apps/betty-server"
      },
      "configurations": {
        "development": {
          "dependsOn": ["install"],
          "command": "nodemon"
        },
        "production": {
          "dependsOn": ["build"],
          "command": "node dist/src/main.js"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betty-server",
        "command": "npm test"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betty-server",
        "command": "npm run test:watch"
      }
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/betty-server",
        "command": "npm run test:coverage"
      }
    }
  }
}
