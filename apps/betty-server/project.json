{
  "name": "betty-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/betty-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/package.json",
        "{projectRoot}/package-lock.json"
      ],
      "outputs": ["{projectRoot}/node_modules"],
      "options": {
        "command": "npm ci --prefer-offline",
        "cwd": "apps/betty-server"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["install"],
      "outputs": ["{workspaceRoot}/dist/apps/betty-server"],
      "options": {
        "main": "apps/betty-server/src/main.ts",
        "tsConfig": "apps/betty-server/tsconfig.app.json",
        "outputPath": "dist/apps/betty-server",
        "clean": true
      },
      "configurations": {
        "development": {
          "dependsOn": []
        },
        "production": {
          "dependsOn": ["install"],
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/betty-server/package.json",
        "{workspaceRoot}/dist/apps/betty-server/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/betty-server/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "command": "nodemon",
        "cwd": "apps/betty-server"
      },
      "configurations": {
        "development": {
          "dependsOn": ["install"],
          "command": "nodemon"
        },
        "production": {
          "dependsOn": ["build"],
          "command": "node ../../dist/apps/betty-server/main.js"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    }
  }
}
