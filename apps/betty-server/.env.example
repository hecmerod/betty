# Configuración de Betty Server - Archivo de ejemplo
# Copia este archivo a .env y configura los valores según tu entorno

NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=betty-secret-key-2024-change-this-in-production
JWT_EXPIRES_IN=24h

# Direcciones MAC permitidas (separadas por comas)
# Formato: XX:XX:XX:XX:XX:XX o XX-XX-XX-XX-XX-XX
# Para obtener tu MAC: ip link show o ifconfig
ALLOWED_MAC_ADDRESSES=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66,a1:b2:c3:d4:e5:f6

# Configuración de seguridad
# Set to 'true' to enable MAC address filtering
ENABLE_MAC_FILTERING=true

# Configuración de memoria para Raspberry Pi
NODE_OPTIONS=--max-old-space-size=512

# Camera Service Configuration
CAMERA_SERVICE_URL=http://localhost:8001/camera

# === FIREBASE CONFIGURATION ===
# Configuración para notificaciones push con Firebase Cloud Messaging
# Obtén estos valores desde la consola de Firebase: 
# https://console.firebase.google.com > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"