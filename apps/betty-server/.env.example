# Configuración de Betty Server - Archivo de ejemplo
# Copia este archivo a .env y configura los valores según tu entorno

NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=betty-secret-key-2024-change-this-in-production
JWT_EXPIRES_IN=24h

# Redis Configuration
# URL de conexión a Redis
# Formato: redis://[username:password@]host[:port][/database]
REDIS_URL=redis://localhost:6379

# Direcciones MAC permitidas (separadas por comas)
# Formato: XX:XX:XX:XX:XX:XX o XX-XX-XX-XX-XX-XX
# Para obtener tu MAC: ip link show o ifconfig
ALLOWED_MAC_ADDRESSES=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66,a1:b2:c3:d4:e5:f6

# Configuración de seguridad
# Set to 'true' to enable MAC address filtering
ENABLE_MAC_FILTERING=true

# Configuración de memoria para Raspberry Pi
NODE_OPTIONS=--max-old-space-size=512

# Camera Service Configuration
CAMERA_SERVICE_URL=http://localhost:8001/camera

# GPIO Configuration
# Rutas al script de control GPIO
GPIO_SCRIPT_PRODUCTION_PATH=/app/scripts/gpio_control.py
GPIO_SCRIPT_DEV_PATH=../../../../scripts/gpio_control.py

# === FIREBASE CONFIGURATION ===
# Configuración para notificaciones push con Firebase Cloud Messaging
# Obtén estos valores desde la consola de Firebase: 
# https://console.firebase.google.com > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# === BORE SSH TUNNEL CONFIGURATION ===
# Configuración de archivos para control del túnel SSH Bore
# Archivo de control para enviar comandos START/STOP al host
BORE_CONTROL_FILE=/home/hecmerod/Projects/betty/tmp/bore-control.txt

# Archivo donde se almacena la URL/comando SSH del túnel activo
BORE_SSH_URL_FILE=/home/hecmerod/Projects/betty/tmp/bore-ssh-url.txt

# === BLUETOOTH/BMS CONFIGURATION ===
# Configuración de adaptadores Bluetooth para cada batería
# La aplicación usa múltiples adaptadores BLE simultáneamente para conectarse a las baterías
# Batería 1: Usa hci0 (Bluetooth integrado de Raspberry Pi)
# Batería 2: Usa hci1 (Dongle USB Bluetooth)
# La configuración se encuentra en: apps/betty-server/src/batteries/infrastructure/repositories/bms-ble.repository.ts
# IMPORTANTE: Asegúrate de que ambos adaptadores estén activos y desbloqueados:
#   - sudo rfkill unblock bluetooth
#   - sudo hciconfig hci0 up
#   - sudo hciconfig hci1 up
