#!/bin/sh

echo "🧪 Verificando archivos modificados..."
echo ""

changed_files=$(git diff --cached --name-only)

if [ -z "$changed_files" ]; then
  echo "ℹ️  No hay archivos modificados"
  exit 0
fi

run_server_tests=false
run_app_tests=false

while IFS= read -r file; do
  if echo "$file" | grep -qE '^apps/betty-server/'; then
    run_server_tests=true
  elif echo "$file" | grep -qE '^apps/betty_app/'; then
    run_app_tests=true
  fi
done << EOF
$changed_files
EOF

if [ "$run_server_tests" = true ]; then
  echo "🔧 Ejecutando tests de betty-server..."
  npm run betty-server:test
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Los tests de betty-server fallaron. Commit cancelado."
    echo ""
    exit 1
  fi
  echo "✅ Tests de betty-server pasaron"
  echo ""
fi

if [ "$run_app_tests" = true ]; then
  echo "📱 Ejecutando tests de betty-app..."
  cd apps/betty_app && flutter test
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ Los tests de betty-app fallaron. Commit cancelado."
    echo ""
    exit 1
  fi
  cd ../..
  echo "✅ Tests de betty-app pasaron"
  echo ""
fi

if [ "$run_server_tests" = false ] && [ "$run_app_tests" = false ]; then
  echo "ℹ️  No hay cambios que requieran tests"
fi
echo ""
